# Server configuration
PORT=3000
NODE_ENV=development

# Bitrix24 Inbound Webhook URL with CRM scope
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.vn/rest/1/your_secret_token/

# Jotform Form ID and API Key credentials
JOTFORM_FORM_ID=123123123
JOTFORM_API_KEY=your_jotform_api_key_here
JOTFORM_API_BASE_URL=https://api.jotform.com

# Logging configuration
LOG_LEVEL=info
LOG_DIR=logs
